class Solution {
    public int strStr(String haystack, String needle) {
        if(needle.length()==0){
            return 0;
        }
        int n= haystack.length();
        int m = needle.length();

        for(int i=0;i<=n-m;i++){
            int matched=0;
            while(matched<m && haystack.charAt(i+matched)==needle.charAt(matched)){
                matched++;
            }
            if(matched==m){
                return i;
            }
        }
        return -1;

    }
}
